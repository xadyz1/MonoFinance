<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="НАЛАШТУВАННЯ ПІДКЛЮЧЕННЯ"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/dialog_et_server_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Адреса сервера (наприклад, https://finance.swiftapps.cloud)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/dialog_et_username"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Ім'я користувача"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/dialog_et_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Пароль"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/dialog_tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Не підключено"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialog_btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_secondary_bg"
            android:text="Вийти"
            android:textColor="@color/type_expense"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="16dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialog_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_secondary_bg"
            android:text="Закрити"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialog_btn_login"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_accent_bg"
            android:text="Увійти"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

</LinearLayout>
